<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.hmdm.control">

    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE"/>
    <!-- reserved -->
<!--    <uses-permission android:name="android.permission.RECORD_AUDIO"/> -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <!-- API 34+: ScreenSharingService is foregroundServiceType="mediaProjection"
         and the app declares this type, so the matching permission is mandatory. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- API 33+: the sharing foreground-service notification is not user-visible
         without POST_NOTIFICATIONS. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Headless resilience: restart the supervisor after a reboot/shutdown. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- API 34+: the ConnectionSupervisor runs as foregroundServiceType="specialUse". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- API 29+: required to surface the screen-capture consent prompt over the
         lock screen (full-screen intent) when an admin joins while idle. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- For test purposes only! -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE"/>

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true"
        android:theme="@style/AppTheme">
        <activity
            android:name=".MainActivity"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:exported="true"
            android:theme="@style/AppTheme.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:label="@string/action_settings"
            android:theme="@style/AppTheme.NoActionBar">
        </activity>

        <service android:name=".GestureDispatchService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:label="@string/app_name"
            android:exported="true">
            <!-- exported=true: the OS itself binds to this service (guarded by
                 BIND_ACCESSIBILITY_SERVICE). API 31+ requires this to be explicit
                 because of the intent-filter below. -->
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>

            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <service android:name=".janus.JanusSessionPollService"
            android:exported="false"/>

        <service android:name=".ScreenSharingService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection"
            />

        <!-- Owns the Janus connection: connect/reconnect with backoff, network
             callback, boot restart, headless gesture dispatch, consent prompt.
             specialUse (API 34+): an always-on remote-control agent session. -->
        <service android:name=".ConnectionSupervisor"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="persistent remote-control agent: maintains the Janus session across screen-off, network changes and reboots" />
        </service>

        <!-- Restarts the supervisor after reboot. Not directBootAware: the room
             id / server URL live in credential-encrypted storage, which is
             unavailable until first unlock (BOOT_COMPLETED is after unlock). -->
        <receiver
            android:name=".BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    </application>

</manifest>